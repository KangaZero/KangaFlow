{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!lib/tokyo-map-data.ts",
      "!pnpm-lock.yaml",
      "!.playwright-mcp"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "domains": {
      "next": "all",
      "project": "all",
      "react": "all"
    },
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnresolvedImports": "off",
        "useImportExtensions": "off"
      },
      "nursery": {
        "preset": "recommended",
        "useTailwindSortedClasses": {
          "level": "error"
        }
      },
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useComponentExportOnlyModules": "off",
        "useConst": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["components/canvasui/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ],
  "tailwind": {
    "mergeFunctions": ["clsx", "cn", "twMerge"],
    "variantFunctions": ["cva"]
  },
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
