# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Public, non-secret build config (the Pages sub-path): committed on purpose.
!.env.production

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

# modern-web-guidance opt-in (set-allow-volatile-features): a per-developer,
# human-only choice, so it must not reach other clones, agents or CI.
.mwgrc

# nix / direnv / git-hooks (generated)
/.direnv/
/result
/result-*
/.pre-commit-config.yaml
